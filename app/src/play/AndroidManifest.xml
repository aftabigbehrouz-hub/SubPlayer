<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play version: no Discover / link downloads, so no background-work service (Play would ask for a foreground-service
     declaration with a video for it). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <application>
        <service android:name="com.behrouz.subplayer.WorkService" tools:node="remove" />
    </application>
</manifest>
